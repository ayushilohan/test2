let previousToken = null;

function initializeToken(token) {
  console.log("Initializing token:", token);
}

function installApp() {
  console.log("Installing app...");
}

function uninstallApp() {
  console.log("Uninstalling app...");
}

function launchApp() {
  console.log("Launching app...");
}

function handleAppFlow(currentToken, isInstalled) {
  const isTokenChanged = previousToken === null || previousToken !== currentToken;

  console.log("\n---");
  console.log("Current Token:", currentToken);
  console.log("Previous Token:", previousToken);
  console.log("Is Installed:", isInstalled);
  console.log("Is Token Changed:", isTokenChanged);

  if (!isInstalled) {
    initializeToken(currentToken);
    installApp();
    launchApp();
    previousToken = currentToken;
  } else {
    // Handle reinstall via TEP case (previousToken = null)
    if (isTokenChanged) {
      initializeToken(currentToken);
      previousToken = currentToken;
    }
    launchApp();
  }
}



