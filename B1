import requests
from bs4 import BeautifulSoup
import json

def scrape_table_to_json(url):
    try:
        # 1. Fetch the webpage
        headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
        }
        response = requests.get(url, headers=headers)
        response.raise_for_status() # Check for HTTP errors
        
        soup = BeautifulSoup(response.text, 'html.parser')
        main_data = {}

        # 2. Locate the table
        table = soup.find('table', class_='informaltable')
        if not table:
            return "Could not find a table with class 'informaltable'."

        # 3. Iterate through rows (skipping the header <thead>)
        tbody = table.find('tbody')
        rows = tbody.find_all('tr') if tbody else table.find_all('tr')[1:]

        for row in rows:
            cells = row.find_all('td')
            
            # Ensure there are at least two columns
            if len(cells) >= 2:
                # The first TD is our heading (the Key)
                heading = cells[0].get_text(strip=True)
                
                # The second TD contains the methods/divs
                methods_list = []
                method_links = cells[1].find_all('a')
                
                for a in method_links:
                    # Extract the main text of the <a> tag
                    # We use recursive=False if we want to separate <a> text from <p> text
                    method_name = a.find(text=True, recursive=False)
                    method_name = method_name.strip() if method_name else a.get_text(strip=True)
                    
                    # Extract child <p> tags within the <a>
                    p_tags = [p.get_text(strip=True) for p in a.find_all('p')]
                    
                    methods_list.append({
                        "method": method_name,
                        "details": p_tags
                    })
                
                # Add to main JSON object
                if heading:
                    main_data[heading] = methods_list

        return json.dumps(main_data, indent=4)

    except Exception as e:
        return f"An error occurred: {e}"

# --- Execution ---
if __name__ == "__main__":
    target_url = input("Please enter the URL to scrape: ")
    json_output = scrape_table_to_json(target_url)
    print("\n--- Scraped JSON Result ---")
    print(json_output)
