import ollama

# This stays 100% inside your network
def private_chat():
    print("--- Private Local Chatbot (Type 'exit' to stop) ---")
    
    # We use a list to keep track of the conversation history locally
    messages = [
        {'role': 'system', 'content': 'You are a helpful office assistant. Provide concise and accurate answers.'}
    ]

    while True:
        user_input = input("You: ")
        if user_input.lower() in ['exit', 'quit']:
            break

        messages.append({'role': 'user', 'content': user_input})

        # Call the local Ollama server
        response = ollama.chat(model='gemma3:4b', messages=messages)
        
        bot_message = response['message']['content']
        print(f"Bot: {bot_message}")
        
        # Add the bot's response to history
        messages.append({'role': 'assistant', 'content': bot_message})

if __name__ == "__main__":
    private_chat()
