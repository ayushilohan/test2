/* SKELETON SIZE FOR LEFT / RIGHT THUMBNAILS */

.skeleton-level-0 {
  width: 90%;
  height: 120px;
  bottom: 0;
  left: 5%;
}

.skeleton-level-1 {
  width: 80%;
  height: 95px;
  bottom: 14px;
  left: 5%;
}

.skeleton-level-2 {
  width: 70%;
  height: 70px;
  bottom: 28px;
  left: 5%;
}

/* REQUIRED BASE */
.simple-skeleton {
  position: absolute;
  border-radius: 10px;
  background: #1f1f1f;
}




{/* LEFT / RIGHT THUMBNAIL SKELETON USAGE */}

<div style={{ position: "relative", height: "40%" }}>
  {prev.map((_, i) => (
    <div
      key={i}
      className={`simple-skeleton skeleton-level-${i}`}
    />
  ))}
</div>

