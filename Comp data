import { useState } from "react";

export default function Component1({ dialogData, setDialogData, onClose }) {
  const [open, setOpen] = useState(true); // dialog opens when component mounts

  const handleChange = (e) => {
    setDialogData({ ...dialogData, input: e.target.value });
  };

  const handleClose = () => {
    setOpen(false);
    onClose(); // clear parent state
  };

  if (!open) return null; // don't render if closed

  return (
    <div className="dialog">
      <h3>Component 1 Dialog</h3>
      <input
        type="text"
        placeholder="Enter value..."
        value={dialogData?.input || ""}
        onChange={handleChange}
      />
      <button onClick={handleClose}>X</button>
    </div>
  );
}



