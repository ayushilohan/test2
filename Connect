document.addEventListener("DOMContentLoaded", function () {
    try {
        var localMsgPort = tizen.messageport.requestLocalMessagePort("SAMPLE_PORT");

        console.log("Receiver App started, waiting for messages...");

        localMsgPort.addMessagePortListener(function (data, remoteMsgPort) {
            console.log("Receiver got message: " + JSON.stringify(data));

            // Reply back
            if (remoteMsgPort) {
                remoteMsgPort.sendMessage([{
                    key: "response",
                    value: "Message received successfully!"
                }]);
            }
        });
    } catch (e) {
        console.error("Receiver error: " + e.message);
    }
});




document.addEventListener("DOMContentLoaded", function () {
    try {
        console.log("Sender App started");

        var remoteMsgPort = tizen.messageport.requestRemoteMessagePort(
            "org.example.receiver", // Receiver App ID (must match config.xml)
            "SAMPLE_PORT"           // Port name (must match receiver)
        );

        console.log("Sending message...");

        remoteMsgPort.sendMessage([{
            key: "msg",
            value: "Hello Receiver, this is Sender!"
        }]);

        console.log("Message sent successfully!");
    } catch (e) {
        console.error("Sender error: " + e.message);
    }
});
