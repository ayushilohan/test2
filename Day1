#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <pthread.h>
#include <dlog.h>
#include <message_port.h>
#include "websocket_server.h"

#define SERVICE_PORT "tpk_service_port"
#define WEBAPP_PORT "wgt_webapp_port"
#define TPK_APP_ID "org.example.tpkservice"     /* replace with your TPK app id */
#define WGT_APP_ID "org.example.wgtapp"         /* replace with your WGT app id */

static int local_port_id = -1;

/* Called when WGT -> TPK message arrives */
static void
on_webapp_message(int local_port, const char *remote_app_id, const char *remote_port,
                  bool trusted, bundle *msg, void *user_data)
{
    const char *data = NULL;
    if (bundle_get_str(msg, "data", &data) != BUNDLE_ERROR_NONE || !data) {
        dlog_print(DLOG_ERROR, TPK_APP_ID, "no data in bundle");
        return;
    }

    dlog_print(DLOG_INFO, TPK_APP_ID, "Received from WGT: %s", data);

    /* Forward to websocket clients */
    websocket_send(data);

    /* Optional: send ack to WGT */
    bundle *resp = bundle_create();
    bundle_add_str(resp, "data", "ACK from TPK");
    message_port_send_message(remote_app_id, WEBAPP_PORT, resp);
    bundle_free(resp);
}

/* Called by websocket_server when a message arrives from remote (APK/PC) */
void on_ws_to_service(const char *msg)
{
    dlog_print(DLOG_INFO, TPK_APP_ID, "Received from WS: %s", msg);

    /* Forward to WGT */
    bundle *b = bundle_create();
    bundle_add_str(b, "data", msg);
    int rc = message_port_send_message(WGT_APP_ID, WEBAPP_PORT, b);
    if (rc != MESSAGE_PORT_ERROR_NONE) {
        dlog_print(DLOG_ERROR, TPK_APP_ID, "message_port_send_message failed: %d", rc);
    }
    bundle_free(b);
}

static bool service_app_create(void *user_data)
{
    dlog_print(DLOG_INFO, TPK_APP_ID, "service create");

    local_port_id = message_port_register_local_port(SERVICE_PORT, on_webapp_message, NULL);
    if (local_port_id < 0) {
        dlog_print(DLOG_ERROR, TPK_APP_ID, "failed register local port: %d", local_port_id);
        return false;
    }
    dlog_print(DLOG_INFO, TPK_APP_ID, "registered local port id: %d", local_port_id);

    /* start websocket server on port 8081 */
    websocket_start_server(8081, on_ws_to_service);

    return true;
}

static void service_app_terminate(void *user_data)
{
    dlog_print(DLOG_INFO, TPK_APP_ID, "service terminate");
    websocket_stop_server();
    if (local_port_id >= 0) {
        message_port_unregister_local_port(SERVICE_PORT);
        local_port_id = -1;
    }
}

/* minimal service_main for tizen native service */
int main(int argc, char *argv[])
{
    /* tizen native service lifecycle glue is usually provided by the template.
       If integrating into template, call service_app_create and service_app_terminate
       from lifecycle callbacks. For standalone testing, call create and wait. */

    if (!service_app_create(NULL)) {
        dlog_print(DLOG_ERROR, TPK_APP_ID, "service_app_create failed");
        return -1;
    }

    /* simple loop to keep process alive */
    while (1) {
        sleep(1);
    }

    /* never reached in this simple example */
    service_app_terminate(NULL);
    return 0;
}

