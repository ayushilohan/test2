wgt/js/app.js

(function(){
  const LOCAL_PORT = "wgt_webapp_port";
  const REMOTE_PORT = "tpk_service_port";
  const REMOTE_APP_ID = "org.example.tpkservice"; // TPK app id

  const logEl = document.getElementById('log');

  function appendLog(s) {
    if (!logEl) return;
    logEl.textContent += s + '\n';
    logEl.scrollTop = logEl.scrollHeight;
  }

  var localPort = null;
  var remotePort = null;

  function initMessagePorts() {
    try {
      localPort = tizen.messageport.requestLocalMessagePort(LOCAL_PORT);
      remotePort = tizen.messageport.requestRemoteMessagePort(REMOTE_APP_ID, REMOTE_PORT);

      localPort.addMessagePortListener(function(data) {
        // data is array of key-value bundles; our simple send uses {data: '...'}
        if (data && data.length > 0) {
          var payload = data[0].data;
          appendLog("SERVICE → WGT: " + payload);
        }
      });

      appendLog("MessagePorts initialized");
    } catch (e) {
      appendLog("MessagePort init error: " + e.message);
    }
  }

  window.sendToService = function(msg) {
    if (!remotePort) {
      appendLog("remotePort not ready");
      return;
    }
    try {
      remotePort.sendMessage({ data: msg });
      appendLog("WGT → SERVICE: " + msg);
    } catch (e) {
      appendLog("sendMessage error: " + e.message);
    }
  };

  document.addEventListener('DOMContentLoaded', function(){
    initMessagePorts();
  });
})();

