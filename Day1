/*
 Uses libwebsockets. This is a compact single-threaded server loop running in a pthread.
 Replace build flags to link against libwebsockets when building the TPK (or embed a small ws lib).
*/

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <pthread.h>
#include <signal.h>
#include <libwebsockets.h>
#include "websocket_server.h"
#include <dlog.h>

#define TAG "org.example.tpkservice.ws"
#define MAX_PAYLOAD 4096

static struct lws_context *context = NULL;
static struct lws *global_wsi = NULL;
static ws_message_cb g_cb = NULL;
static int g_port = 0;
static pthread_t ws_thread;
static volatile int ws_running = 0;

static int callback_ws(struct lws *wsi, enum lws_callback_reasons reason,
                       void *user, void *in, size_t len)
{
    switch (reason) {
        case LWS_CALLBACK_ESTABLISHED:
            dlog_print(DLOG_INFO, TAG, "client connected");
            global_wsi = wsi;
            break;

        case LWS_CALLBACK_RECEIVE:
            if (in && len > 0) {
                char *msg = (char*)malloc(len + 1);
                if (msg) {
                    memcpy(msg, in, len);
                    msg[len] = '\0';
                    dlog_print(DLOG_INFO, TAG, "ws recv: %s", msg);
                    if (g_cb) g_cb(msg);
                    free(msg);
                }
            }
            break;

        case LWS_CALLBACK_CLOSED:
            dlog_print(DLOG_INFO, TAG, "client closed");
            if (global_wsi == wsi) global_wsi = NULL;
            break;

        default:
            break;
    }
    return 0;
}

static struct lws_protocols protocols[] = {
    { "tpk-protocol", callback_ws, 0, MAX_PAYLOAD },
    { NULL, NULL, 0, 0 }
};

static void *ws_service_loop(void *arg)
{
    struct lws_context_creation_info info;
    memset(&info, 0, sizeof(info));
    info.port = g_port;
    info.protocols = protocols;
    info.options = LWS_SERVER_OPTION_LIBEVENT;

    context = lws_create_context(&info);
    if (!context) {
        dlog_print(DLOG_ERROR, TAG, "lws_create_context failed");
        return NULL;
    }

    ws_running = 1;
    while (ws_running) {
        lws_service(context, 50);
    }

    lws_context_destroy(context);
    context = NULL;
    return NULL;
}

void websocket_start_server(int port, ws_message_cb cb)
{
    if (ws_running) return;
    g_port = port;
    g_cb = cb;
    pthread_create(&ws_thread, NULL, ws_service_loop, NULL);
    pthread_detach(ws_thread);
    /* small delay for context to be created; in production use sync signal */
    sleep(1);
    dlog_print(DLOG_INFO, TAG, "websocket server started on port %d", port);
}

void websocket_stop_server(void)
{
    ws_running = 0;
    /* allow loop to exit */
    sleep(1);
    dlog_print(DLOG_INFO, TAG, "websocket server stopped");
}

void websocket_send(const char *msg)
{
    if (!context || !global_wsi || !msg) return;

    size_t len = strlen(msg);
    unsigned char *buf = (unsigned char*)malloc(LWS_PRE + len);
    if (!buf) return;

    memcpy(&buf[LWS_PRE], msg, len);
    int n = lws_write(global_wsi, &buf[LWS_PRE], len, LWS_WRITE_TEXT);
    if (n < 0) {
        dlog_print(DLOG_ERROR, TAG, "lws_write failed: %d", n);
    }
    free(buf);
}

