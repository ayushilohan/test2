import React, { useState } from "react";

function DragDropDemo() {
  const [droppedItems, setDroppedItems] = useState([]);
  const [dialogs, setDialogs] = useState([]);
  const [firstDroppedType, setFirstDroppedType] = useState(null);

  const handleDrop = (buttonType) => {
    // Save first dropped type
    if (!firstDroppedType) {
      setFirstDroppedType(buttonType);
    }

    // Decide logic based on who came first
    const isReversed = firstDroppedType === "button2";

    if (
      (buttonType === "button1" && !isReversed) ||
      (buttonType === "button2" && isReversed)
    ) {
      // This button shows input directly
      setDroppedItems((prev) => [
        ...prev,
        { id: Date.now(), type: buttonType, value: "" }
      ]);
    } else {
      // This button opens a dialog first
      const newDialog = { id: Date.now(), type: buttonType, value: "" };
      setDialogs((prev) => [...prev, newDialog]);
    }
  };

  const handleDialogChange = (id, value) => {
    setDialogs((prev) =>
      prev.map((dlg) => (dlg.id === id ? { ...dlg, value } : dlg))
    );
  };

  const handleDialogSubmit = (dialog) => {
    setDroppedItems((prev) => [...prev, dialog]);
    setDialogs((prev) => prev.filter((dlg) => dlg.id !== dialog.id));
  };

  return (
    <div>
      {/* Buttons to simulate drop */}
      <button onClick={() => handleDrop("button1")}>Button 1</button>
      <button onClick={() => handleDrop("button2")}>Button 2</button>

      {/* Fixed bottom container */}
      <div
        style={{
          position: "fixed",
          bottom: 0,
          width: "100%",
          border: "1px solid black",
          padding: "10px",
          background: "#f9f9f9",
        }}
      >
        {droppedItems.map((item) => (
          <div
            key={item.id}
            style={{ margin: "8px", padding: "6px", border: "1px solid gray" }}
          >
            <p>{item.type}</p>
            {/* If item was input-based */}
            {item.value === "" && (
              <input
                type="text"
                placeholder="Enter value"
                value={item.value}
                onChange={(e) => {
                  setDroppedItems((prev) =>
                    prev.map((it) =>
                      it.id === item.id ? { ...it, value: e.target.value } : it
                    )
                  );
                }}
              />
            )}
            {/* If item came from dialog */}
            {item.value !== "" && <p>Value: {item.value}</p>}
          </div>
        ))}
      </div>

      {/* Multiple dialogs */}
      {dialogs.map((dialog) => (
        <div
          key={dialog.id}
          style={{
            position: "fixed",
            top: "30%",
            left: "40%",
            background: "white",
            border: "1px solid black",
            padding: "20px",
          }}
        >
          <h4>Enter Value for {dialog.type}</h4>
          <input
            type="text"
            value={dialog.value}
            onChange={(e) => handleDialogChange(dialog.id, e.target.value)}
          />
          <button onClick={() => handleDialogSubmit(dialog)}>Submit</button>
        </div>
      ))}
    </div>
  );
}

export default DragDropDemo;
