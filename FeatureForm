// FeatureForm.js
import React, { useState } from 'react';

function FeatureForm() {
  const [formData, setFormData] = useState({
    featureType: 'HTV',
    url: '',
    bindingType: 'key',
    encryption: 'false',
  });

  const handleChange = (e) => {
    const { name, value } = e.target;
    setFormData(prev => ({ ...prev, [name]: value }));
  };

  const handleSubmit = (e) => {
    e.preventDefault();

    const jsonString = JSON.stringify(formData, null, 2);
    const blob = new Blob([jsonString], { type: 'application/json' });
    const downloadUrl = URL.createObjectURL(blob);

    const link = document.createElement('a');
    link.href = downloadUrl;
    link.download = 'feature-config.json';
    link.click();
  };

  return (
    <form onSubmit={handleSubmit} style={{ padding: 20, maxWidth: 400 }}>
      <label>Feature Type:</label>
      <select name="featureType" value={formData.featureType} onChange={handleChange}>
        <option value="HTV">HTV</option>
        <option value="SS">SS</option>
      </select>

      <label>URL:</label>
      <input type="text" name="url" value={formData.url} onChange={handleChange} required />

      <label>Binding Type:</label>
      <select name="bindingType" value={formData.bindingType} onChange={handleChange}>
        <option value="key">Key</option>
        <option value="time">Time</option>
      </select>

      <label>Encryption:</label>
      <select name="encryption" value={formData.encryption} onChange={handleChange}>
        <option value="true">True</option>
        <option value="false">False</option>
      </select>

      <button type="submit" style={{ marginTop: 20 }}>Generate JSON</button>
    </form>
  );
}

export default FeatureForm;
