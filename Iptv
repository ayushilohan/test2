var channels = [
  { name: "News", videoSrc: "video0.mp4" },
  { name: "Sports", videoSrc: "video1.mp4" },
  { name: "Movies", videoSrc: "video2.mp4" }
];

var list = document.getElementById('channelList');
var listItems = list.getElementsByTagName('li');
var videoPlayer = document.getElementById('videoPlayer');
var currentIndex = 0;

function updateFocusAndPlay() {
  for (var i = 0; i < listItems.length; i++) {
    if (i === currentIndex) {
      listItems[i].className = 'focused';
    } else {
      listItems[i].className = '';
    }
  }

  playVideo(currentIndex);
}

function playVideo(index) {
  videoPlayer.src = channels[index].videoSrc;
  videoPlayer.load();
  videoPlayer.play();
}

window.onload = function () {
  updateFocusAndPlay();

  if (typeof tizen !== 'undefined' && tizen.tvinputdevice) {
    tizen.tvinputdevice.registerKey("ChannelUp");
    tizen.tvinputdevice.registerKey("ChannelDown");
  }

  document.addEventListener("keydown", function (e) {
    if (e.keyCode === 427) {
      // ChannelUp
      currentIndex = (currentIndex + 1) % listItems.length;
      updateFocusAndPlay();
    } else if (e.keyCode === 428) {
      // ChannelDown
      currentIndex = (currentIndex - 1 + listItems.length) % listItems.length;
      updateFocusAndPlay();
    }
  });
};






<ul id="channelList">
  <li>News</li>
  <li>Sports</li>
  <li>Movies</li>
</ul>

<video id="videoPlayer" width="640" height="360" controls autoplay></video>
