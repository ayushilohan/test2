visualization/radar.py
-----------------------------------
import matplotlib.pyplot as plt
from config import X_LIMIT, Y_LIMIT, MAX_POINTS

x_data = []
y_data = []

def update_plot(x, y):
    global x_data, y_data

    x_data.append(x)
    y_data.append(y)

    x_data = x_data[-MAX_POINTS:]
    y_data = y_data[-MAX_POINTS:]

    plt.cla()
    plt.scatter(x_data, y_data)
    plt.xlim(0, X_LIMIT)
    plt.ylim(0, Y_LIMIT)
    plt.title("LiDAR Radar View (XQ-L2)")
    plt.xlabel("X")
    plt.ylabel("Y")
    plt.grid()


-----------------------------------
main.py
-----------------------------------
import matplotlib.pyplot as plt
import matplotlib.animation as animation

from lidar.reader import connect, read_line
from lidar.parser import parse_xy
from visualization.radar import update_plot

ser = connect()

def update(frame):
    line = read_line(ser)
    if line:
        print(line)
        x, y = parse_xy(line)
        if x is not None:
            update_plot(x, y)

fig = plt.figure()
ani = animation.FuncAnimation(fig, update, interval=100)

plt.show()


