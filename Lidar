import serial
from config import PORT, BAUDRATE

def connect():
    return serial.Serial(PORT, BAUDRATE, timeout=1)

def read_line(ser):
    if ser.in_waiting > 0:
        return ser.readline().decode(errors='ignore').strip()
    return None


