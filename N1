// index.html
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Network Tab</title>
<style>
body { background:#0f172a; color:#e5e7eb; font-family:Arial; }
table { width:100%; border-collapse:collapse; font-size:12px; }
th,td { padding:6px; border-bottom:1px solid #1f2933; }
th { background:#020617; position:sticky; top:0; }
.ok { color:#22c55e; }
.fail { color:#ef4444; }
</style>
</head>
<body>

<h3>Network</h3>

<table>
<thead>
<tr>
<th>Type</th>
<th>Method</th>
<th>URL</th>
<th>Status</th>
<th>Time</th>
<th>Size</th>
</tr>
</thead>
<tbody id="net"></tbody>
</table>

<script>
var tbody = document.getElementById("net");

var socket = new WebSocket("ws://localhost:PORT"); // same as existing

socket.onmessage = function (e) {
    var msg = JSON.parse(e.data);
    if (msg.type !== "network") return;

    var d = msg.payload;
    var tr = document.createElement("tr");

    tr.innerHTML =
        "<td>" + d.api + "</td>" +
        "<td>" + d.method + "</td>" +
        "<td>" + d.url + "</td>" +
        "<td class='" + (d.status < 400 ? "ok" : "fail") + "'>" + d.status + "</td>" +
        "<td>" + d.time + " ms</td>" +
        "<td>" + d.size + "</td>";

    tbody.appendChild(tr);
};
</script>

</body>
</html>
