// network-hook.js
<script>
(function () {

    function sendNetworkLog(data) {
        if (window.__DEBUG_SOCKET__ && window.__DEBUG_SOCKET__.readyState === 1) {
            window.__DEBUG_SOCKET__.send(JSON.stringify({
                type: "network",
                payload: data
            }));
        }
    }

    /* -------- FETCH -------- */
    if (window.fetch) {
        var _fetch = window.fetch;
        window.fetch = function () {
            var start = new Date().getTime();
            var method = "GET";
            var url = arguments[0];

            if (arguments[1] && arguments[1].method) {
                method = arguments[1].method;
            }

            return _fetch.apply(this, arguments).then(function (res) {
                var clone = res.clone();
                clone.text().then(function (txt) {
                    sendNetworkLog({
                        api: "fetch",
                        method: method,
                        url: url,
                        status: res.status,
                        time: new Date().getTime() - start,
                        size: txt.length
                    });
                });
                return res;
            });
        };
    }

    /* -------- XHR -------- */
    var OldXHR = window.XMLHttpRequest;

    function NewXHR() {
        var xhr = new OldXHR();
        var start, url, method;

        xhr.open = function (m, u) {
            method = m;
            url = u;
            OldXHR.prototype.open.apply(xhr, arguments);
        };

        xhr.send = function () {
            start = new Date().getTime();
            xhr.addEventListener("loadend", function () {
                sendNetworkLog({
                    api: "xhr",
                    method: method,
                    url: url,
                    status: xhr.status,
                    time: new Date().getTime() - start,
                    size: xhr.responseText ? xhr.responseText.length : 0
                });
            });
            OldXHR.prototype.send.apply(xhr, arguments);
        };

        return xhr;
    }

    window.XMLHttpRequest = NewXHR;

})();
</script>





