// main.js (Parent)
import { useState } from "react";
import Component1 from "./Component1";
import Component2 from "./Component2";

export default function Main() {
  const [active, setActive] = useState("c1");
  const [unsavedChanges, setUnsavedChanges] = useState(false);

  const handleSwitch = (target) => {
    if (unsavedChanges) {
      const confirmLeave = window.confirm(
        "You have unsaved changes. If you switch, your data will be lost."
      );
      if (!confirmLeave) return;
      setUnsavedChanges(false); // reset if switching
    }
    setActive(target);
  };

  return (
    <div>
      <button onClick={() => handleSwitch("c1")}>Button 1</button>
      <button onClick={() => handleSwitch("c2")}>Button 2</button>

      {active === "c1" && <Component1 setUnsavedChanges={setUnsavedChanges} />}
      {active === "c2" && <Component2 setUnsavedChanges={setUnsavedChanges} />}
    </div>
  );
}

// Example Component1.js
import { useState } from "react";

export default function Component1({ setUnsavedChanges }) {
  const [text, setText] = useState("");

  const handleChange = (e) => {
    setText(e.target.value);
    setUnsavedChanges(true); // mark dirty
  };

  return (
    <div>
      <h2>Component 1</h2>
      <input value={text} onChange={handleChange} />
    </div>
  );
}
