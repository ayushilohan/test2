const http = require("http");
const WebSocket = require("ws");

const N8N_URL = "PASTE_N8N_WEBHOOK_URL";

const server = http.createServer();
const wss = new WebSocket.Server({ server });

wss.on("connection", ws => {
  console.log("TV connected");
});

// call n8n, get command, send to TV
function fetchCommandAndSend() {
  http.get(N8N_URL, res => {
    let body = "";
    res.on("data", c => body += c);
    res.on("end", () => {
      console.log("From n8n:", body);
      wss.clients.forEach(ws => {
        if (ws.readyState === WebSocket.OPEN) {
          ws.send(body);
        }
      });
    });
  });
}

// example trigger (manual / timer / API)
setInterval(fetchCommandAndSend, 3000);

server.listen(3000, () => {
  console.log("Server running on 3000");
});
