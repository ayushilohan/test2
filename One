import React, { useEffect, useState } from "react";
import "./App.css";

const videos = [
  { id: 1, title: "Video 1" },
  { id: 2, title: "Video 2" },
  { id: 3, title: "Video 3" },
  { id: 4, title: "Video 4" },
];

export default function App() {
  const [currentIndex, setCurrentIndex] = useState(1);

  // Handle keyboard arrow keys
  useEffect(() => {
    const handleKey = (e) => {
      // For now using normal ArrowLeft / ArrowRight
      if (e.key === "ArrowLeft") {
        setCurrentIndex((prev) => Math.max(prev - 1, 0));
      } else if (e.key === "ArrowRight") {
        setCurrentIndex((prev) => Math.min(prev + 1, videos.length - 1));
      }

      // 🔒 Tizen remote keys (commented for now)
      /*
      if (e.keyCode === 37) { // Left Arrow on Tizen
        setCurrentIndex((prev) => Math.max(prev - 1, 0));
      } else if (e.keyCode === 39) { // Right Arrow on Tizen
        setCurrentIndex((prev) => Math.min(prev + 1, videos.length - 1));
      }
      */
    };

    window.addEventListener("keydown", handleKey);
    return () => window.removeEventListener("keydown", handleKey);
  }, []);

  return (
    <div className="container">
      {videos.map((video, index) => {
        const isActive = index === currentIndex;
        const offset = index - currentIndex;

        return (
          <div
            key={video.id}
            className={`card ${isActive ? "active" : "inactive"}`}
            style={{
              transform: `translateX(${offset * 250}px) scale(${isActive ? 1.2 : 0.8})`,
              opacity: isActive ? 1 : 0.6,
              zIndex: isActive ? 2 : 1,
            }}
          >
            {video.title}
          </div>
        );
      })}
    </div>
  );
}
