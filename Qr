<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>QR Generator</title>
    <script src="https://unpkg.com/qr-code-styling/lib/qr-code-styling.js"></script>
</head>
<body>
    <div id="qr"></div>
    <button onclick="downloadQR()">Download QR</button>

    <script>
        var qrcode = new QRCodeStyling({
            width: 300,
            height: 300,
            data: "https://example.com", // put your QR data here
            dotsOptions: { color: "#0f0" },
            backgroundOptions: { color: "#000" },
            cornersSquareOptions: { color: "#ff0000" },
            cornersDotOptions: { color: "#ffff00" },
            imageOptions: { margin: 5 }
        });

        qrcode.append(document.getElementById("qr"));

        function downloadQR() {
            qrcode.download({ name: "fixed_qr", extension: "png" });
        }
    </script>
</body>
</html>
