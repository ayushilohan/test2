import { useState, useEffect } from "react";
import { gsap } from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";
import "./Main.css";

gsap.registerPlugin(ScrollTrigger);

const Main = () => {
  const [openDropdown, setOpenDropdown] = useState(null);
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const toggleDropdown = (option) => setOpenDropdown(openDropdown === option ? null : option);
  const toggleMobileMenu = () => setMobileMenuOpen(!mobileMenuOpen);

  useEffect(() => {
    const handleClickOutside = (event) => {
      if (!event.target.closest('.dropdown-container')) setOpenDropdown(null);
      if (!event.target.closest('.mobile-menu') && !event.target.closest('.burger-icon')) {
        setMobileMenuOpen(false);
      }
    };

    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  // 5-line paragraph placeholder
  const paragraph = `
    Lorem ipsum dolor sit amet, consectetur adipiscing elit.
    Praesent et ligula non nulla sagittis faucibus.
    Integer vel metus vitae massa commodo malesuada.
    Sed id nulla at turpis placerat tincidunt.
    Fusce eget justo vitae ligula vulputate dapibus.
  `;

  // Dropdown menu items for each option
  const dropdownItems = {
    'Option 1': ['Sub-option 1.1', 'Sub-option 1.2', 'Sub-option 1.3'],
    'Option 2': ['Sub-option 2.1', 'Sub-option 2.2', 'Sub-option 2.3', 'Sub-option 2.4'],
    'Option 3': ['Sub-option 3.1', 'Sub-option 3.2'],
    'Option 4': ['Sub-option 4.1', 'Sub-option 4.2', 'Sub-option 4.3', 'Sub-option 4.4', 'Sub-option 4.5'],
    'Option 5': ['Sub-option 5.1', 'Sub-option 5.2', 'Sub-option 5.3']
  };

  return (
    <>
      {/* Header Section */}
      <header>
        <div className="logo">Logo</div>
        <div className="burger-icon" onClick={toggleMobileMenu}>
          <div className={`bar ${mobileMenuOpen ? 'open' : ''}`}></div>
          <div className={`bar ${mobileMenuOpen ? 'open' : ''}`}></div>
          <div className={`bar ${mobileMenuOpen ? 'open' : ''}`}></div>
        </div>
        <nav>
          <ul>
            {Object.keys(dropdownItems).map((option) => (
              <li key={option} className="dropdown-container">
                <button className="dropdown-button" onClick={() => toggleDropdown(option)}>
                  {option}
                  <span className="dropdown-arrow">
                    {openDropdown === option ? '▲' : '▼'}
                  </span>
                </button>
                {openDropdown === option && (
                  <ul className="dropdown-menu">
                    {dropdownItems[option].map((subOption, index) => (
                      <li key={index} className="dropdown-item">
                        {subOption}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </header>

      {/* Mobile Menu Sidebar */}
      <div className={`mobile-menu ${mobileMenuOpen ? 'open' : ''}`}>
        <div className="mobile-menu-header">
          <div className="mobile-logo">Logo</div>
          <button className="close-btn" onClick={toggleMobileMenu}>×</button>
        </div>
        <div className="mobile-menu-content">
          {Object.keys(dropdownItems).map((option) => (
            <div key={option} className="mobile-dropdown">
              <button className="mobile-dropdown-btn" onClick={() => toggleDropdown(option)}>
                {option}
                <span className="dropdown-arrow">
                  {openDropdown === option ? '▲' : '▼'}
                </span>
              </button>
              {openDropdown === option && (
                <ul className="mobile-dropdown-menu">
                  {dropdownItems[option].map((subOption, index) => (
                    <li key={index} className="mobile-dropdown-item">
                      {subOption}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>

      <main>
        {/* Banner Section */}
        <section className="banner">
          <div className="banner-content">
            <div className="banner-text">
              <h1>Big Banner</h1>
            </div>
          </div>
        </section>

        {/* Info Bar Section */}
        <section className="info-bar">
          <div><p>Paragraph 1</p></div>
          <div><p>Paragraph 2</p></div>
          <div><p>Paragraph 3</p></div>
          <div><p>Paragraph 4</p></div>
        </section>

        {/* Content Rows Section */}
        {[1, 2, 3, 4, 5].map((item, index) => (
          <section key={index} className={`content-row ${index % 2 !== 0 ? "reverse" : ""}`} >
            <div className="image">Image {item}</div>
            <div className="text">{paragraph}</div>
          </section>
        ))}
      </main>

      {/* Footer Section */}
      <footer>
        <p>&copy; 2024 Beautiful Design. All rights reserved.</p>
      </footer>
    </>
  );
};

export default Main;



