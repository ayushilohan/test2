import { useState, useEffect, useRef } from "react";

export default function ShortsLayout() {
  const videos = [
    "https://www.w3schools.com/html/mov_bbb.mp4",
    "https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4",
    "https://www.w3schools.com/html/movie.mp4",
    "https://interactive-examples.mdn.mozilla.net/media/cc0-videos/bee.mp4",
  ];

  const [currentIndex, setCurrentIndex] = useState(0);
  const [focusIndex, setFocusIndex] = useState(0); // 0 follow, 1 like, 2 emoji
  const [isFollowing, setIsFollowing] = useState(false);
  const [likes, setLikes] = useState(300);
  const [showHeart, setShowHeart] = useState(false);
  const [arrowFocus, setArrowFocus] = useState(null);

  const videoRef = useRef(null);

  /* Reset follow + focus when video changes */
  useEffect(() => {
    setIsFollowing(false);
    setFocusIndex(0);
  }, [currentIndex]);

  /* Auto play next video */
  useEffect(() => {
    const v = videoRef.current;
    if (!v) return;
    v.onended = () => {
      if (currentIndex < videos.length - 1) {
        setCurrentIndex((p) => p + 1);
      }
    };
  }, [currentIndex]);

  /* Keyboard navigation */
  useEffect(() => {
    const handleKey = (e) => {
      switch (e.key) {
        case "ArrowRight":
          setArrowFocus("right");
          if (currentIndex < videos.length - 1)
            setCurrentIndex((p) => p + 1);
          break;

        case "ArrowLeft":
          setArrowFocus("left");
          if (currentIndex > 0)
            setCurrentIndex((p) => p - 1);
          break;

        case "ArrowUp":
          setFocusIndex((p) => Math.max(0, p - 1));
          break;

        case "ArrowDown":
          setFocusIndex((p) => Math.min(2, p + 1));
          break;

        case "Enter":
          if (focusIndex === 0) setIsFollowing(true);
          if (focusIndex === 1) handleLike();
          if (focusIndex === 2) alert("Emoji clicked");
          break;

        default:
          break;
      }

      setTimeout(() => setArrowFocus(null), 200);
    };

    window.addEventListener("keydown", handleKey);
    return () => window.removeEventListener("keydown", handleKey);
  }, [focusIndex, currentIndex]);

  const handleLike = () => {
    setLikes((p) => p + 1);
    setShowHeart(true);
    setTimeout(() => setShowHeart(false), 800);
  };

  const focusStyle = (i) => ({
    border: focusIndex === i ? "2px solid #ff0050" : "1px solid #999",
    boxShadow: focusIndex === i ? "0 0 10px #ff0050" : "none",
    padding: "8px",
    marginBottom: "10px",
    borderRadius: "10px",
    background: "#111",
    color: "white",
    textAlign: "center",
  });

  const box = {
    margin: "8px",
    borderRadius: "12px",
    border: "1px solid #444",
    padding: "8px",
    position: "relative",
  };

  return (
    <div style={{ height: "100vh", display: "flex", background: "#000" }}>
      {/* LEFT COLUMN */}
      <div style={{ width: "33.33%", display: "flex", flexDirection: "column" }}>
        <div style={{ ...box, height: "60%" }}>
          <div>👤 creator_name</div>
          <button>Follow</button>
          <p>Description of the video goes here...</p>
          <div style={{ marginTop: "10px", fontSize: "12px" }}>
            Live Chat
            <div>User1: Hi</div>
            <div>User2: Nice!</div>
          </div>
        </div>

        <div style={{ ...box, height: "40%" }}>Previous cards</div>
      </div>

      {/* CENTER COLUMN */}
      <div style={{ width: "33.33%", position: "relative" }}>
        <div style={{ ...box, height: "100%" }}>
          <video
            ref={videoRef}
            key={videos[currentIndex]}
            src={videos[currentIndex]}
            autoPlay
            preload="metadata"
            style={{ width: "100%", height: "100%", objectFit: "contain" }}
          />

          {/* Left / Right arrows */}
          <div
            style={{
              position: "absolute",
              left: "5px",
              top: "50%",
              fontSize: "30px",
              color: arrowFocus === "left" ? "red" : "white",
            }}
          >
            ◀
          </div>

          <div
            style={{
              position: "absolute",
              right: "5px",
              top: "50%",
              fontSize: "30px",
              color: arrowFocus === "right" ? "red" : "white",
            }}
          >
            ▶
          </div>

          {/* Follow info */}
          <div style={{ position: "absolute", top: "10px", left: "10px" }}>
            <div style={focusStyle(0)}>Follow</div>
            {isFollowing && <div>Following</div>}
          </div>

          {/* Like / Emoji column */}
          <div
            style={{
              position: "absolute",
              right: "10px",
              bottom: "20px",
            }}
          >
            <div style={focusStyle(1)}>
              ❤️ {likes}
            </div>

            <div style={focusStyle(2)}>🔥</div>
          </div>

          {/* Heart animation */}
          {showHeart && (
            <div
              style={{
                position: "absolute",
                top: "40%",
                left: "45%",
                fontSize: "80px",
                animation: "fade 0.8s",
              }}
            >
              ❤️
            </div>
          )}
        </div>
      </div>

      {/* RIGHT COLUMN */}
      <div style={{ width: "33.33%", display: "flex", flexDirection: "column" }}>
        <div style={{ ...box, height: "60%" }}>
          {isFollowing && (
            <div style={{ color: "red", animation: "blink 1s infinite" }}>
              Join us on Instagram!
            </div>
          )}
        </div>

        <div style={{ ...box, height: "40%" }}>Next cards</div>
      </div>

      {/* Animations */}
      <style>
        {`
          @keyframes fade {
            from { opacity: 1; transform: scale(1); }
            to { opacity: 0; transform: scale(1.5); }
          }

          @keyframes blink {
            50% { opacity: 0; }
          }
        `}
      </style>
    </div>
  );
}
