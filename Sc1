import requests
from bs4 import BeautifulSoup
import json
import os
import urllib3

# Suppress SSL warnings when verify=False is used
urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

def scrape_feature(url):
    """Scrapes the content of a single page while ignoring SSL errors."""
    try:
        # verify=False bypasses the SSL certificate error
        res = requests.get(url, timeout=10, verify=False)
        res.raise_for_status() # Check if the request was successful
        
        soup = BeautifulSoup(res.text, 'html.parser')
        
        # Extracting data
        title = soup.find('h1').get_text(strip=True) if soup.find('h1') else "No Title"
        content_div = soup.find('div', id='content') or soup.find('article') or soup.find('main')
        body = content_div.get_text(separator="\n", strip=True) if content_div else "No content found"
        
        return {"title": title, "url": url, "content": body}
    except Exception as e:
        print(f"  ! Error on {url}: {e}")
        return None

def main():
    print("--- Tizen Docs Scraper (SSL Bypass Enabled) ---")
    
    while True:
        feature_name = input("\nEnter feature name (e.g., bluetooth) or 'q' to quit: ").strip().lower()
        if feature_name == 'q':
            break
            
        start_url = input(f"Enter the Tizen URL for '{feature_name}': ").strip()
        
        print(f"Scraping... please wait.")
        data = scrape_feature(start_url)
        
        if data:
            # Generate file in the current root directory
            file_name = f"{feature_name}.json"
            
            with open(file_name, 'w', encoding='utf-8') as f:
                json.dump(data, f, indent=4, ensure_ascii=False)
            
            # Use os.getcwd() to show exactly where it was saved
            print(f"✅ Success! File saved at: {os.path.join(os.getcwd(), file_name)}")
        else:
            print("❌ Failed to capture data. Please check the URL.")

if __name__ == "__main__":
    main()
