export default BurgerMenu;




// burgermenu.css
/* Burger Icon Styling */
.burger-menu {
  width: 40px;
  height: 40px;
  padding: 10px;
  background-color: #333;
  color: white;
  cursor: pointer;
  position: fixed;
  top: 10px;
  right: 10px;
  z-index: 1100;
  font-size: 24px;
  text-align: center;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Side Panel - Hidden State */
.side-panel {
  position: fixed;
  top: 0;
  right: -300px; /* hidden off screen */
  width: 300px;
  height: 100vh;
  background-color: #fff;
  box-shadow: -2px 0 8px rgba(0, 0, 0, 0.1);
  z-index: 1000;
  padding: 20px;
  transition: all 0.3s ease-in-out;

  /* Hide visually and functionally */
  opacity: 0;
  pointer-events: none;
}

/* Side Panel - Visible State */
.side-panel.visible {
  right: 0;
  opacity: 1;
  pointer-events: auto;
}

.side-panel ul {
  padding-left: 0;
  list-style: none;
}

.side-panel li {
  margin-bottom: 10px;
}

.side-panel button {
  background: none;
  border: none;
  font-size: 16px;
  color: #333;
  cursor: pointer;
  padding: 0;
  text-align: left;
}

.side-panel button:hover {
  color: #007bff;
  text-decoration: underline;
}

