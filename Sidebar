      }
    },
    {
      id: 3,
      payload: null,
      jsonNode: {
        scenario3: {}
      }
    }
  ];

  // Extract scenario keys like scenario1, scenario2, ...
  const scenarioNames = data.map(item => Object.keys(item.jsonNode)[0]);
  const handleScenarioClick = (name) => {
    console.log("Clicked:", name);
    // You can add more logic here like navigation or showing details
  };
  

  return (
    <>
      <div
        className="burger-menu"
        onMouseEnter={() => setIsVisible(true)}
      >
        ☰
      </div>

      <div
        className={`side-panel ${isVisible ? 'visible' : ''}`}
