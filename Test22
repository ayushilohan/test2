<div class="container">
  <div class="sidebar">
    <ul class="menu">
      <li class="menu-item focused" id="menu-0">Home</li>
      <li class="menu-item" id="menu-1">Settings</li>
    </ul>
  </div>

  <div class="content">
    <div id="page-home" class="page"> <!-- Home Page -->
      <h2>🏠 Home</h2>
      <p>Welcome to the Home Page</p>
    </div>

    <div id="page-settings" class="page"> <!-- Settings Page -->
      <h2>⚙️ Settings</h2>
      <p>Adjust your preferences here.</p>
    </div>
  </div>
</div>





.page {
  display: none;
}
.page.active {
  display: block;
}





window.onload = function () {
  var currentFocus = 0;
  var totalItems = 2;

  function updateFocus() {
    for (var i = 0; i < totalItems; i++) {
      var item = document.getElementById('menu-' + i);
      if (item) item.classList.toggle('focused', i === currentFocus);
    }
  }

  function showPage(index) {
    var pages = ['page-home', 'page-settings'];
    for (var i = 0; i < pages.length; i++) {
      var page = document.getElementById(pages[i]);
      if (page) page.classList.toggle('active', i === index);
    }
  }

  document.addEventListener('keydown', function (e) {
    if (e.key === 'ArrowDown') {
      currentFocus = (currentFocus + 1) % totalItems;
      updateFocus();
    } else if (e.key === 'ArrowUp') {
      currentFocus = (currentFocus - 1 + totalItems) % totalItems;
      updateFocus();
    } else if (e.key === 'Enter') {
      showPage(currentFocus);
    }
  });

  updateFocus();
  showPage(0); // show Home by default
};
