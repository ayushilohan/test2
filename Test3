.virtual-remote {
  position: fixed;
  top: 20px;         /* ⬅️ From top */
  right: 20px;       /* ⬅️ From right */
  background: #444;
  padding: 20px;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  z-index: 1000;     /* Make sure it's on top */
}
.virtual-remote {
  position: fixed;
  bottom: 40px;
  right: 40px;
  background: #444;
  padding: 20px;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.virtual-remote button {
  width: 60px;
  height: 40px;
  margin: 4px;
  font-size: 18px;
  cursor: pointer;
}




document.getElementById('up').onclick = () => simulateKey('ArrowUp');
document.getElementById('down').onclick = () => simulateKey('ArrowDown');
document.getElementById('left').onclick = () => simulateKey('ArrowLeft');
document.getElementById('right').onclick = () => simulateKey('ArrowRight');
document.getElementById('ok').onclick = () => simulateKey('Enter');

function simulateKey(key) {
  document.dispatchEvent(new KeyboardEvent('keydown', { key }));
}



<div class="virtual-remote">
  <button id="up">↑</button><br />
  <button id="left">←</button>
  <button id="ok">OK</button>
  <button id="right">→</button><br />
  <button id="down">↓</button>
</div>
