$(document).ready(function () {
  const $sidebarBtns = [$('#menu1'), $('#menu2')];
  const $remoteBtns = [$('#remote-up'), $('#remote-down')];

  let currentSection = 'sidebar';
  let sidebarIndex = 0;
  let remoteIndex = 0;

  function updateFocus() {
    $('.selected').removeClass('selected');

    if (currentSection === 'sidebar') {
      $sidebarBtns[sidebarIndex].addClass('selected').focus();
    } else {
      $remoteBtns[remoteIndex].addClass('selected').focus();
    }
  }

  $(document).on('keydown', function (e) {
    if (currentSection === 'sidebar') {
      if (e.key === 'ArrowRight') {
        currentSection = 'remote';
        updateFocus();
      } else if (e.key === 'ArrowDown') {
        sidebarIndex = (sidebarIndex + 1) % $sidebarBtns.length;
        updateFocus();
      } else if (e.key === 'ArrowUp') {
        sidebarIndex = (sidebarIndex - 1 + $sidebarBtns.length) % $sidebarBtns.length;
        updateFocus();
      }
    } else if (currentSection === 'remote') {
      if (e.key === 'ArrowLeft') {
        currentSection = 'sidebar';
        updateFocus();
      } else if (e.key === 'ArrowDown') {
        remoteIndex = (remoteIndex + 1) % $remoteBtns.length;
        updateFocus();
      } else if (e.key === 'ArrowUp') {
        remoteIndex = (remoteIndex - 1 + $remoteBtns.length) % $remoteBtns.length;
        updateFocus();
      }
    }
  });

  updateFocus(); // Initial focus
});
