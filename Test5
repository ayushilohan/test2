import React from 'react';

const Sidebar = ({ setPage }) => {
  return (
    <div style={{ width: '20%', background: '#f0f0f0', padding: '10px' }}>
      <button onClick={() => setPage('page1')}>Page 1</button><br />
      <button onClick={() => setPage('page2')}>Page 2</button><br />
      <button onClick={() => setPage('page3')}>Page 3</button><br />
      <button onClick={() => setPage('page4')}>Page 4</button><br />
      <button onClick={() => setPage('page5')}>Page 5</button>
    </div>
  );
};

export default Sidebar;
