import React from 'react';

const DialogBox = ({ message, onClose, type }) => {
  const dialogStyle = {
    position: 'fixed',
    top: '30%',
    left: '50%',
    transform: 'translate(-50%, -50%)',
    backgroundColor: '#fff',
    border: `2px solid ${type === 'success' ? 'green' : 'red'}`,
    padding: '20px',
    zIndex: 1000,
    borderRadius: '8px',
    boxShadow: '0 4px 8px rgba(0,0,0,0.2)',
    minWidth: '300px',
    textAlign: 'center'
  };

  return (
    <div style={dialogStyle}>
      <p style={{ color: type === 'success' ? 'green' : 'red' }}>{message}</p>
      <button onClick={onClose}>OK</button>
    </div>
  );
};

export default DialogBox;





import React, { useState } from 'react';
import DialogBox from './DialogBox'; // adjust path as needed

const Page1 = () => {
  const [input, setInput] = useState('');
  const [items, setItems] = useState([]);
  const [dialog, setDialog] = useState({ visible: false, message: '', type: '' });

  const handleAdd = () => {
    if (input.trim() === '') return;
    setItems([input]);
    setInput('');
  };

  const handleSubmit = async () => {
    if (items.length === 0) {
      setDialog({ visible: true, message: 'Please add a URL first', type: 'error' });
      return;
    }

    const bodyData = [
      {
        urls: items[0],
        Vodenum: 'mp4'
      }
    ];

    try {
      const response = await fetch('https://your-api-endpoint.com/post', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(bodyData),
      });

      if (response.ok) {
        const data = await response.json();
        console.log('POST Success:', data);
        setDialog({ visible: true, message: 'Submitted successfully!', type: 'success' });
      } else {
        setDialog({ visible: true, message: 'Submission failed!', type: 'error' });
      }
    } catch (error) {
      console.error('Fetch error:', error);
      setDialog({ visible: true, message: 'Something went wrong!', type: 'error' });
    }
  };

  return (
    <div>
      <h2>Submit URL</h2>
      <input
        type="text"
        value={input}
        onChange={(e) => setInput(e.target.value)}
        placeholder="Enter URL"
      />
      <button onClick={handleAdd}>Add</button>
      <button onClick={handleSubmit}>Submit</button>

      {dialog.visible && (
        <DialogBox
          message={dialog.message}
          type={dialog.type}
          onClose={() => setDialog({ visible: false, message: '', type: '' })}
        />
      )}
    </div>
  );
};

export default Page1;
