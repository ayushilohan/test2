.truncate {
  width: 200px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.truncate:hover::after {
  content: attr(data-fulltext);
  position: absolute;
  background: #333;
  color: #fff;
  padding: 4px 8px;
  border-radius: 4px;
  white-space: normal;
  max-width: 300px;
  z-index: 10;
  margin-top: 4px;
}
