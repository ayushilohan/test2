var timer = null;
var timeLeft = 30; // seconds

function play() {
    if (timer !== null) {
        clearInterval(timer);
    }
    timeLeft = 30;

    timer = setInterval(function () {
        console.log("Time left: " + timeLeft + "s");
        timeLeft = timeLeft - 1;

        if (timeLeft < 0) {
            clearInterval(timer);
            timer = null;
            console.log("Countdown finished");
        }
    }, 1000);
}

function stop() {
    if (timer !== null) {
        clearInterval(timer);
        timer = null;
    }
}
