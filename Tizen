window.onload = function () {
    initApp();
};

function initApp() {
    console.log("App initialized");

    const lastState = localStorage.getItem("tvState");
    const lastTimestamp = parseInt(localStorage.getItem("tvStateTimestamp"));
    const currentTime = Date.now();
    const isRecent = lastTimestamp && (currentTime - lastTimestamp < 12 * 60 * 60 * 1000); // 12 hours

    const currentDisplayState = webapis.tv.power.getScreenState(); // true = display ON
    console.log("Last saved state:", lastState);
    console.log("Last saved time:", new Date(lastTimestamp).toString());
    console.log("Current screen state:", currentDisplayState);

    if (lastState === "displayOn" && !currentDisplayState && isRecent) {
        console.log("Likely power cut. Forcing display ON...");
        webapis.tv.power.setScreenState(true); // Force display ON
        showEmergencyMessage();
    }

    // Save current state and timestamp
    const newState = currentDisplayState ? "displayOn" : "standby";
    localStorage.setItem("tvState", newState);
    localStorage.setItem("tvStateTimestamp", currentTime);
}

function showEmergencyMessage() {
    const msgDiv = document.createElement("div");
    msgDiv.innerText = "🚨 Emergency Alert: Please evacuate!";
    msgDiv.style.position = "fixed";
    msgDiv.style.top = "40%";
    msgDiv.style.left = "10%";
    msgDiv.style.color = "white";
    msgDiv.style.fontSize = "48px";
    msgDiv.style.background = "rgba(255, 0, 0, 0.8)";
    msgDiv.style.padding = "20px";
    msgDiv.style.zIndex = "9999";
    msgDiv.style.borderRadius = "8px";
    document.body.appendChild(msgDiv);
}






