window.onload = function () {
    try {
        tizen.systeminfo.getPropertyValue("DISPLAY", function(display) {
            const isScreenOn = display.brightness > 0;
            const stateString = isScreenOn ? "displayOn" : "standby";

            // Save to localStorage
            localStorage.setItem("tvState", stateString);
            localStorage.setItem("tvStateTimestamp", Date.now());

            // Read back for logging
            const storedState = localStorage.getItem("tvState");
            const storedTime = new Date(parseInt(localStorage.getItem("tvStateTimestamp")));

            // Log
            console.log("Screen brightness:", display.brightness);
            console.log("Current screen state:", stateString);
            console.log("Stored state:", storedState);
            console.log("Timestamp:", storedTime.toString());
        }, function(error) {
            console.log("Error reading screen info:", error.message);
        });
    } catch (err) {
        console.log("Fatal error:", err.message);
    }
};
