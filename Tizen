let flag = 0;
const box = document.getElementById("statusBox");

function init() {
  flag = 0;
  localStorage.setItem("appFlag", "0");
  box.innerHTML = "🚀 App started (Flag = 0)";

  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "hidden") {
      const prev = localStorage.getItem("appFlag");
      flag = 2;
      localStorage.setItem("appFlag", "2");
      box.innerHTML = `📴 App went into standby<br>Previous Flag: ${prev} → Current Flag: 2`;
    } else if (document.visibilityState === "visible") {
      const prev = localStorage.getItem("appFlag");
      flag = 1;
      localStorage.setItem("appFlag", "1");
      box.innerHTML = `📺 App is visible again<br>Previous Flag: ${prev} → Current Flag: 1`;

      if (prev === "2") {
        box.innerHTML += "<br>✅ Resumed from standby";
      }
    }
  });
}

window.onload = init;
