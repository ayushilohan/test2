window.onload = function () {
    try {
        // Simulate display state manually
        const stateString = "displayOn"; // or "standby", depending on your logic

        // Store state
        localStorage.setItem("tvState", stateString);
        localStorage.setItem("tvStateTimestamp", Date.now());

        // Read back
        const storedState = localStorage.getItem("tvState");
        const storedTime = new Date(parseInt(localStorage.getItem("tvStateTimestamp")));

        console.log("Stored screen state:", storedState);
        console.log("Timestamp:", storedTime.toString());
    } catch (err) {
        console.log("Error:", err.message);
    }
};
