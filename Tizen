window.onload = function() {
    try {
        const rp = webapis.remotepower;
        const cur = rp.getPowerState();   // "NORMAL", "STANDBY", etc.
        const t = Date.now();
        localStorage.tvPowerState = cur;
        localStorage.tvPowerTimestamp = t.toString();
        console.log("Cur:", cur, "Prev:", localStorage.tvPowerState, "Δ:", t - parseInt(localStorage.tvPowerTimestamp));

        if (localStorage.tvPowerState === "NORMAL" && cur === "STANDBY" && (t - parseInt(localStorage.tvPowerTimestamp)) < 60000) {
            console.log("Detected possible power out event—waking screen.");
            webapis.tv.power.setScreenState(true);
        }
    } catch (e) {
        console.error("RemotePower error:", e.message);
    }
};
