<!DOCTYPE html>
<html>
<head>
    <title>Force Load No-Cache Test</title>
    <script>
        window.onload = function() {
            // Build script URL with force load & no cache
            var timestamp = new Date().getTime(); 
            document.write('<script type="text/javascript" src="engine.js?forceload=1&nocache=1&v=' + timestamp + '"><\/script>');
        }
    </script>
</head>
<body>
    <h1>Force Load & No-Cache Test on HAU8000</h1>
    <div id="engineStatus">Waiting for engine...</div>
</body>
</html>



document.getElementById("engineStatus").innerText =
    "Engine loaded successfully (No-Cache) at " + new Date().toLocaleTimeString();
