.container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  overflow: hidden;
}

.card {
  width: 200px;
  height: 300px;
  background: #444;
  color: white;
  font-size: 1.2rem;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 10px;
  border-radius: 10px;
  transition: all 0.3s ease;
}

.active {
  background: #e50914;
}

.inactive {
  background: #666;
}
