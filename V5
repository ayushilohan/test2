var ottFlag = false;
var intervalId = null;

function startInterval() {
    if (intervalId !== null) return;
    intervalId = setInterval(function () {
        console.log("Interval running...");
    }, 500);
}

function stopInterval() {
    if (intervalId === null) return;
    clearInterval(intervalId);
    intervalId = null;
    console.log("Interval stopped");
}

function makeOttOn() {
    ottFlag = true;
    startInterval();
}

function makeOttOff() {
    ottFlag = false;
    stopInterval();
}

// ---- Keys ----
document.addEventListener('keydown', function (e) {
    // EXIT key on Samsung TV
    if (e.keyCode === 10182) {
        makeOttOff();
    }
});

// ---- Call this when YouTube launches ----
function onYouTubeLaunch() {
    makeOttOn();
}
