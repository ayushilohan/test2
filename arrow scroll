// jsx
import { useEffect } from "react";
import "./ScrollAnimation.css";
import img from "../image/fast-forward.png";

export default function ScrollAnimation() {
  useEffect(() => {
    const handleScroll = () => {
      const scrollY = window.scrollY;
      const vh = window.innerHeight;
      const progress = Math.min(scrollY / vh, 1);

      const bannerImg = document.querySelector(".banner-img");
      const c1 = document.querySelector(".c1");
      const c2 = document.querySelector(".c2");

      const leftMid = document.querySelector(".mid-left");
      const rightMid = document.querySelector(".mid-right");

      /* Banner rotation */
      bannerImg.style.transform = `rotate(${progress * 90}deg)`;

      /* Shapes motion */
      c1.style.transform = `
        translate(${Math.sin(scrollY * 0.01) * 40}px,
                  ${Math.cos(scrollY * 0.01) * 40}px)
      `;

      c2.style.transform = `
        translate(${Math.cos(scrollY * 0.01) * 40}px,
                  ${Math.sin(scrollY * 0.01) * 40}px)
      `;

      /* Mid images move DOWN on scroll */
      const moveDown = progress * 200; // adjust distance
      const moveUp = progress * -200;

      leftMid.style.transform = `
        translateY(${moveDown}px)
        rotate(${progress * 270}deg)
      `;

      rightMid.style.transform = `
        translateY(${moveUp}px)
        rotate(${progress * 90}deg)
      `;
    };

    window.addEventListener("scroll", handleScroll);
    return () => window.removeEventListener("scroll", handleScroll);
  }, []);

  return (
    <>
      {/* Background shapes */}
      <div className="shapes">
        <span className="circle c1" />
        <span className="circle c2" />
      </div>

      {/* Floating mid images */}
      <img src={img} className="mid-image mid-left" alt="" />
      <img src={img} className="mid-image mid-right" alt="" />

      {/* Banner */}
      <section className="banner">
        <img src={img} alt="" className="banner-img" />
        <h1>Scroll Animation Demo</h1>
      </section>

      {/* Spacer to allow scrolling */}
      <div style={{ height: "200vh" }} />
    </>
  );
}





// css
body {
  margin: 0;
  background: #ffffff;
  color: black;
  overflow-x: hidden;
}

/* Banner */
.banner {
  height: 100vh;
  display: flex;
  align-items: center;
  gap: 20px;
  padding-left: 80px;
}

.banner-img {
  width: 80px;
}

/* Floating mid images */
.mid-image {
  position: fixed;
  width: 60px;
  opacity: 0.8;
  transition: transform 0.2s ease-out;
  z-index: 5;
}

/* Start at mid-bottom */
.mid-left {
  left: 40px;
  top: 60%;
}

.mid-right {
  right: 40px;
  top: 60%;
}

/* Shapes */
.shapes {
  position: fixed;
  inset: 0;
  z-index: -1;
}

.circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
  background: linear-gradient(135deg, #ff7a18, #ffb347);
}

.c1 {
  width: 250px;
  height: 250px;
  top: 20%;
  left: 10%;
}

.c2 {
  width: 180px;
  height: 180px;
  bottom: 15%;
  right: 15%;
}

