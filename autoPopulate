import React, { useState } from 'react';
import './BurgerMenu.css';
import DialogBox from './DialogBox'; // Import your DialogBox component

const BurgerMenu = () => {
  const [isVisible, setIsVisible] = useState(false);
  const [dialogOpen, setDialogOpen] = useState(false);
  const [dialogItems, setDialogItems] = useState([]);
  const [selectedScenario, setSelectedScenario] = useState('');

  const data = [
    {
      id: 1,
      payload: null,
      jsonNode: {
        scenario1: {}
      }
    },
    {
      id: 2,
      payload: null,
      jsonNode: {
        scenario2: {}
      }
    },
    {
      id: 3,
      payload: null,
      jsonNode: {
        scenario3: {}
      }
    }
  ];

  const scenarioNames = data.map(item => Object.keys(item.jsonNode)[0]);

  const handleScenarioClick = async (scenario) => {
    try {
      // simulate API call with dummy data
      const response = await fetch(`/api/fetch-scenario/${scenario}`);
      const result = await response.json();

      // expected result: array of items
      const mappedItems = result.map((val, i) => ({
        id: Date.now() + i,
        value: val.value || `Item ${i + 1}`,
        configShown: true,
        config: {
          bindType: val.bindType || '',
          encryption: val.encryption || 'false',
          timeValue: val.timeValue || '',
          subOptionsEnabled: val.subOptionsEnabled || false,
          subInputs: val.subInputs || ['', '', '', '']
        }
      }));

      setSelectedScenario(scenario);
      setDialogItems(mappedItems);
      setDialogOpen(true);
    } catch (error) {
      console.error('Failed to fetch scenario data:', error);
    }
  };

  return (
    <>
      <div
        className="burger-menu"
        onMouseEnter={() => setIsVisible(true)}
      >
        ☰
      </div>

      <div
        className={`side-panel ${isVisible ? 'visible' : ''}`}
        onMouseLeave={() => setIsVisible(false)}
      >
        <h3>Scenarios</h3>
        <ul>
          {scenarioNames.map((name, index) => (
            <li key={index}>
              <button onClick={() => handleScenarioClick(name)}>
                {name}
              </button>
            </li>
          ))}
        </ul>
      </div>

      {dialogOpen && (
        <DialogBox
          selectedButton={selectedScenario}
          initialItems={dialogItems}
          onClose={() => setDialogOpen(false)}
        />
      )}
    </>
  );
};

export default BurgerMenu;



