import React, { useState, useEffect } from 'react';
import { motion } from 'framer-motion';

const DigitalEyes = () => {
  const [isConfused, setIsConfused] = useState(false);
  const [isBlinking, setIsBlinking] = useState(false);

  // Auto-blink logic
  useEffect(() => {
    const blinkInterval = setInterval(() => {
      setIsBlinking(true);
      setTimeout(() => setIsBlinking(false), 150);
    }, 4000);
    return () => clearInterval(blinkInterval);
  }, []);

  const eyeVariants = {
    open: { scaleY: 1, rotate: 0 },
    blink: { scaleY: 0.1, rotate: 0 },
    confused: { scaleY: 0.8, rotate: 15 },
  };

  // Full screen container styles
  const screenStyle = {
    width: '100vw',
    height: '100vh',
    backgroundColor: '#000',
    display: 'flex',
    flexDirection: 'column',
    justifyContent: 'center',
    alignItems: 'center',
    overflow: 'hidden',
    cursor: 'pointer',
    margin: 0,
    padding: 0
  };

  const eyeContainerStyle = {
    display: 'flex',
    gap: '6vw', // Responsive gap based on screen width
  };

  const eyeStyle = {
    width: 'clamp(80px, 15vw, 150px)', // Responsive sizing
    height: 'clamp(60px, 12vw, 120px)',
    backgroundColor: '#66E0FF',
    borderRadius: '40px',
    boxShadow: '0 0 30px rgba(102, 224, 255, 0.8)',
  };

  return (
    <div style={screenStyle} onClick={() => setIsConfused(!isConfused)}>
      <div style={eyeContainerStyle}>
        {/* Left Eye */}
        <motion.div
          animate={isBlinking ? "blink" : isConfused ? "confused" : "open"}
          variants={eyeVariants}
          transition={{ type: 'spring', stiffness: 200, damping: 15 }}
          style={eyeStyle}
        />
        
        {/* Right Eye */}
        <motion.div
          animate={isBlinking ? "blink" : isConfused ? "confused" : "open"}
          variants={{
            ...eyeVariants,
            confused: { scaleY: 0.8, rotate: -15 }
          }}
          transition={{ type: 'spring', stiffness: 200, damping: 15 }}
          style={eyeStyle}
        />
      </div>
      
      <motion.p 
        initial={{ opacity: 0.3 }}
        animate={{ opacity: isConfused ? 1 : 0.3 }}
        style={{ 
          color: '#66E0FF', 
          fontFamily: 'monospace', 
          marginTop: '40px',
          letterSpacing: '2px',
          position: 'absolute',
          bottom: '10%'
        }}
      >
        {isConfused ? "STATUS: PERPLEXED" : "STATUS: ACTIVE"}
      </motion.p>
    </div>
  );
};

export default DigitalEyes;
