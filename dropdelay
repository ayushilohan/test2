// create slice
import { createSlice } from "@reduxjs/toolkit";

const dropDelaySlice = createSlice({
  name: "dropDelay",
  initialState: { value: "" },
  reducers: {
    setDropDelay: (state, action) => {
      state.value = action.payload;
    },
    resetDropDelay: (state) => {
      state.value = "";
    }
  }
});

export const { setDropDelay, resetDropDelay } = dropDelaySlice.actions;
export default dropDelaySlice.reducer;





// add it to store
import { configureStore } from "@reduxjs/toolkit";
import dropDelayReducer from "./dropDelaySlice";

const store = configureStore({
  reducer: {
    dropDelay: dropDelayReducer,
  },
});

export default store;





// provide
import React from "react";
import { Provider } from "react-redux";
import store from "./store";
import DropDelay from "./DropDelay";

function App() {
  return (
    <Provider store={store}>
      <DropDelay />
    </Provider>
  );
}

export default App;







// component
import React from "react";
import { useDispatch, useSelector } from "react-redux";
import { setDropDelay } from "./dropDelaySlice";

const DropDelay = () => {
  const dispatch = useDispatch();
  const value = useSelector((state) => state.dropDelay.value);

  return (
    <div>
      <label>Drop Delay (ms): </label>
      <input
        type="number"
        value={value}
        onChange={(e) => dispatch(setDropDelay(e.target.value))}
        placeholder="Enter delay in ms"
      />
      <p>Current value: {value}</p>
    </div>
  );
};

export default DropDelay;

