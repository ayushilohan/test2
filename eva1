<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sample Long Page</title>

    <style>
        :root {
            --dark-purple: #3b2c4a;
            --beige: #f3efe6;
            --dark-green: #2f4f3e;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: var(--beige);
            color: var(--dark-purple);
        }

        /* Header */
        header {
            padding: 16px;
        }

        header > div {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: var(--dark-purple);
            color: var(--beige);
            border-radius: 12px;
            padding: 14px 24px;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 20px;
            margin: 0;
            padding: 0;
        }

        nav li {
            cursor: pointer;
        }

        /* Banner */
        .banner {
            height: 320px;
            margin: 24px 16px 0 16px;
            background-color: var(--dark-green);
            color: var(--beige);
            border-radius: 16px 16px 0 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        /* Info Bar */
        .info-bar {
            margin: 0 16px 40px 16px;
            background-color: var(--dark-purple);
            color: var(--beige);
            border-radius: 0 0 16px 16px;
        }

        .info-bar > div {
            display: flex;
        }

        .info-bar > div > div {
            flex: 1;
            padding: 20px;
            border-right: 1px solid rgba(255,255,255,0.2);
        }

        .info-bar > div > div:last-child {
            border-right: none;
        }

        /* Image & Description Rows */
        main section {
            display: flex;
            align-items: center;
            gap: 32px;
            margin: 24px 16px;
            padding: 24px;
            background-color: #ffffff;
            border-radius: 16px;
        }

        main img {
            width: 220px;
            height: 150px;
            background-color: var(--beige);
            border-radius: 12px;
        }

        /* Footer */
        footer {
            margin: 32px 16px 16px;
            padding: 28px;
            background-color: var(--dark-green);
            color: var(--beige);
            border-radius: 16px;
            text-align: center;
        }
    </style>
</head>

<body>

    <!-- Header -->
    <header>
        <div>
            <h2>Logo</h2>
            <nav>
                <ul>
                    <li>Option 1</li>
                    <li>Option 2</li>
                    <li>Option 3</li>
                    <li>Option 4</li>
                    <li>Option 5</li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- Banner -->
    <section class="banner">
        <h1>Big Banner Section</h1>
        <p>Banner content goes here</p>
    </section>

    <!-- Info Bar -->
    <section class="info-bar">
        <div>
            <div><p>Section 1 paragraph</p></div>
            <div><p>Section 2 paragraph</p></div>
            <div><p>Section 3 paragraph</p></div>
            <div><p>Section 4 paragraph</p></div>
        </div>
    </section>

    <!-- Content -->
    <main>
        <section>
            <img alt="Image 1" />
            <p>Description for image 1</p>
        </section>

        <section>
            <p>Description for image 2</p>
            <img alt="Image 2" />
        </section>

        <section>
            <img alt="Image 3" />
            <p>Description for image 3</p>
        </section>

        <section>
            <p>Description for image 4</p>
            <img alt="Image 4" />
        </section>

        <section>
            <img alt="Image 5" />
            <p>Description for image 5</p>
        </section>
    </main>

    <!-- Footer -->
    <footer>
        Footer
    </footer>

</body>
</html>
