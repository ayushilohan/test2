// Content sections animation
    sectionRefs.current.forEach((section) => {
      const image = section.querySelector(".image");
      const text = section.querySelector(".text");
      const isReverse = section.classList.contains("reverse");

      const imageX = isReverse ? 120 : -120;
      const textX  = isReverse ? -120 : 120;

      // ROTATE VALUES — keep what is already working for you
      const imageRotate = isReverse ? 6 : -6;
      const textRotate  = isReverse ? -6 : 6;

      // IMAGE
      gsap.fromTo(
        image,
        { x: 0, rotate: 0, opacity: 1 },
        {
          x: imageX,
          rotate: imageRotate,
          opacity: 0.2,              // 👈 fade out smoothly
          scrollTrigger: {
            trigger: section,
            start: "top 70%",
            end: "bottom 30%",
            scrub: 1
          },
          ease: "power2.out"
        }
      );

      // TEXT
      gsap.fromTo(
        text,
        { x: 0, rotate: 0, opacity: 1 },
        {
          x: textX,
          rotate: textRotate,
          opacity: 0.2,              // 👈 fade out smoothly
          scrollTrigger: {
            trigger: section,
            start: "top 70%",
            end: "bottom 30%",
            scrub: 1
          },
          ease: "power2.out"
        }
      );
    });

