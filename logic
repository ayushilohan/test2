// Listen for key events (remote simulation)
document.addEventListener("keydown", (e) => {
  if (onHome) {
    if (e.key === "1") selectedLanguage = "EN";
    if (e.key === "2") selectedLanguage = "KR";

    if (e.key === "Enter") {
      // Assume GC is selected
      openGCPage();
    }
  }
});




function openGCPage() {
    onHome = false;
    document.getElementById("home").style.display = "none";
    document.getElementById("gcPage").style.display = "block";

    if (selectedLanguage === "EN") {
      document.getElementById("gcContent").innerText = "Welcome to Google Cast (English)";
    } else {
      document.getElementById("gcContent").innerText = "구글 캐스트에 오신 것을 환영합니다 (Korean)";
    }
  }



// simulate back navigation
  function goHome() {
    onHome = true;
    document.getElementById("home").style.display = "block";
    document.getElementById("gcPage").style.display = "none";
  }




