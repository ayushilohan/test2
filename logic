// translations.js
const translations = {
  en: {
    title: "Welcome",
    menu1: "Movies",
    menu2: "TV Shows",
    settings: "Settings",
  },
  ko: {
    title: "환영합니다",
    menu1: "영화",
    menu2: "TV 쇼",
    settings: "설정",
  },
};

let currentLang = "en";

function updateUI() {
  document.getElementById("title").innerText = translations[currentLang].title;
  document.getElementById("menu1").innerText = translations[currentLang].menu1;
  document.getElementById("menu2").innerText = translations[currentLang].menu2;
  document.getElementById("settings").innerText =
    translations[currentLang].settings;
}

document.addEventListener("keydown", function (e) {
  switch (e.keyCode) {
    case 49: // button 1
      currentLang = "en";
      updateUI();
      break;

    case 50: // button 2
      currentLang = "ko";
      updateUI();
      break;
  }
});

// initial load
window.onload = updateUI;
