// app.js
import React, { useState, useEffect } from "react";
import "./App.css";

const episodes = Array.from({ length: 10 }, (_, i) => `Episode ${i + 1}`);
const seasons = ["Season 1", "Season 2", "Season 3"];

export default function App() {
  const [activeIndex, setActiveIndex] = useState(3);

  const handleKeyDown = (e) => {
    if (e.key === "ArrowRight") {
      setActiveIndex((prev) => (prev + 1) % episodes.length);
    }
    if (e.key === "ArrowLeft") {
      setActiveIndex((prev) => (prev - 1 + episodes.length) % episodes.length);
    }
  };

  useEffect(() => {
    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, []);

  return (
    <div className="wrapper">
      {/* Center carousel */}
      <div className="container">
        {episodes.map((item, index) => {
          const distance = index - activeIndex;
          if (Math.abs(distance) > 3) return null;

          let className = "card";
          if (index === activeIndex) {
            className += " active";
          } else {
            className += " inactive";
          }

          return (
            <div key={index} className={className}>
              {item}
            </div>
          );
        })}
      </div>

      {/* Fixed right side season buttons */}
      <div className="seasons-panel">
        {seasons.map((s, i) => (
          <button key={i} className="season-btn">
            {s}
          </button>
        ))}
      </div>
    </div>
  );
}






// app.css
.wrapper {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  height: 100vh;
  background: #fff;
  overflow: hidden;
  padding-bottom: 40px;
  position: relative;
}

/* Carousel container */
.container {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 20px;
  flex: 1;
}

/* Base card */
.card {
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 6px;
  transition: all 0.5s ease;
  font-size: 16px;
  color: white;
  position: relative;
}

/* Active card */
.card.active {
  width: 240px;
  height: 420px;
  background: #ff4d4d;
  font-weight: bold;
  z-index: 3;
}

/* Inactive (same height for all non-active) */
.card.inactive {
  width: 160px;
  height: 300px;
  background: #3a3a3a;
  z-index: 1;
}

/* Right side fixed seasons */
.seasons-panel {
  display: flex;
  flex-direction: column;
  gap: 12px;
  position: absolute;
  right: 40px;
  top: 100px;
}

.season-btn {
  background: #e5e5e5;
  padding: 8px 16px;
  border: none;
  border-radius: 4px;
  font-size: 14px;
  cursor: pointer;
}
