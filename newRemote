.remote-container {
  width: 220px;
  background: #1b1b1b;
  color: white;
  padding: 10px;
  border-radius: 15px;
  position: fixed;
  top: 15%;
  left: 42%;
  box-shadow: 0 0 10px rgba(0,0,0,0.6);
  font-family: sans-serif;
  font-size: 12px;
}

.remote-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.remote-header button {
  background: none;
  border: none;
  color: white;
  font-size: 14px;
  cursor: pointer;
}

.remote-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}

.row {
  display: flex;
  justify-content: center;
  gap: 6px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
  margin: 6px 0;
}

.nav {
  text-align: center;
  margin-top: 6px;
}

.nav .mid-nav {
  display: flex;
  justify-content: center;
  gap: 6px;
  margin: 4px 0;
}

.colors {
  display: flex;
  gap: 6px;
  margin-top: 6px;
}

.btn {
  background: #333;
  border: none;
  border-radius: 6px;
  color: white;
  padding: 6px 8px;
  min-width: 50px;
  cursor: pointer;
  font-size: 12px;
  text-align: center;
}

.btn.red { background-color: #e53935; }
.btn.green { background-color: #43a047; }
.btn.yellow { background-color: #fdd835; color: black; }
.btn.blue { background-color: #1e88e5; }

.btn.power {
  background-color: #b71c1c;
  font-weight: bold;
}

.btn:hover {
  background-color: #95be5f;
}
.ok-btn:hover {
  background-color: #0a84ff;
  color: white;
}

.remote-input {
  width: 100%;
  padding: 8px;
  margin-bottom: 10px;
  font-size: 14px;
  border-radius: 6px;
  border: none;
  background: #f5f5f5;
  color: #333;
}
