import React, { useState } from 'react';
import './VirtualRemote.css';

function VirtualRemote({ tag, onClose }) {
  const [inputValue, setInputValue] = useState('');

  if (!tag) return null;

  const handleButtonClick = (value) => {
    setInputValue(value);
  };

  return (
    <div className="remote-container">
      <div className="remote-header">
        <span>{tag}</span>
        <button onClick={onClose}>✖</button>
      </div>

      {/* Input box */}
      <input
        className="remote-input"
        type="text"
        value={inputValue}
        readOnly
        placeholder="Selected Button"
      />

      <div className="remote-body">
        {/* Top Section */}
        <div className="row">
          <button className="btn power" onClick={() => handleButtonClick('Power')}>⏻</button>
          <button className="btn" onClick={() => handleButtonClick('Source')}>SOURCE</button>
        </div>

        {/* Number pad */}
        <div className="grid">
          {[1, 2, 3, 4, 5, 6, 7, 8, 9, 0].map(num => (
            <button key={num} className="btn" onClick={() => handleButtonClick(num)}>{num}</button>
          ))}
        </div>

        {/* Volume / Channel Controls */}
        <div className="row">
          <button className="btn" onClick={() => handleButtonClick('VOL +')}>VOL +</button>
          <button className="btn" onClick={() => handleButtonClick('CH +')}>CH +</button>
        </div>
        <div className="row">
          <button className="btn" onClick={() => handleButtonClick('MUTE')}>MUTE</button>
          <button className="btn" onClick={() => handleButtonClick('MEDIA')}>MEDIA</button>
        </div>
        <div className="row">
          <button className="btn" onClick={() => handleButtonClick('VOL -')}>VOL -</button>
          <button className="btn" onClick={() => handleButtonClick('CH -')}>CH -</button>
        </div>

        {/* Navigation */}
        <div className="nav">
          <button className="btn up" onClick={() => handleButtonClick('▲')}>▲</button>
          <div className="mid-nav">
            <button className="btn" onClick={() => handleButtonClick('◄')}>◄</button>
            <button className="btn ok-btn" onClick={() => handleButtonClick('OK')}>OK</button>
            <button className="btn" onClick={() => handleButtonClick('►')}>►</button>
          </div>
          <button className="btn down" onClick={() => handleButtonClick('▼')}>▼</button>
        </div>

        {/* Tools/Info/Color Buttons */}
        <div className="row">
          <button className="btn" onClick={() => handleButtonClick('TOOLS')}>TOOLS</button>
          <button className="btn" onClick={() => handleButtonClick('INFO')}>INFO</button>
        </div>
        <div className="colors">
          <button className="btn red" onClick={() => handleButtonClick('A')}>A</button>
          <button className="btn green" onClick={() => handleButtonClick('B')}>B</button>
          <button className="btn yellow" onClick={() => handleButtonClick('C')}>C</button>
          <button className="btn blue" onClick={() => handleButtonClick('D')}>D</button>
        </div>
      </div>
    </div>
  );
}

export default VirtualRemote;


