//ScrollAnimation.css
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: #0b0b0b;
  color: white;
  overflow-x: hidden;
  font-family: sans-serif;
}

/* ---------- Banner ---------- */
.banner {
  height: 100vh;
  display: flex;
  align-items: center;
  gap: 20px;
  padding-left: 80px;
}

.banner-img {
  width: 80px;
  transition: transform 0.3s ease;
}

.banner h1 {
  font-size: 60px;
}

/* ---------- Section ---------- */
.scroll-section {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 100px;
}

.content {
  width: 40%;
  transition: transform 0.3s ease, opacity 0.3s ease;
}

.content img {
  width: 100%;
}

/* ---------- Shapes ---------- */
.shapes {
  position: fixed;
  inset: 0;
  z-index: -1;
}

.circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
  background: linear-gradient(135deg, #ff7a18, #ffb347);
}

.c1 {
  width: 250px;
  height: 250px;
  top: 20%;
  left: 10%;
}

.c2 {
  width: 180px;
  height: 180px;
  bottom: 15%;
  right: 15%;
}
