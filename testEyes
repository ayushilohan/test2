import React, { useState, useEffect } from 'react';
import { motion } from 'framer-motion';

const AdvancedRobotFace = () => {
  const [expression, setExpression] = useState('smiling');
  const [isBlinking, setIsBlinking] = useState(false);

  useEffect(() => {
    const sequence = ['smiling', 'lookLeft', 'lookRight', 'smiling', 'curious', 'open'];
    let i = 0;
    const interval = setInterval(() => {
      i = (i + 1) % sequence.length;
      setExpression(sequence[i]);
    }, 5000);
    return () => clearInterval(interval);
  }, []);

  useEffect(() => {
    const triggerBlink = () => {
      setIsBlinking(true);
      setTimeout(() => setIsBlinking(false), 120);
      setTimeout(triggerBlink, Math.random() * 3000 + 3000);
    };
    const timer = setTimeout(triggerBlink, 2000);
    return () => clearTimeout(timer);
  }, []);

  // --- SVG Path Logic for Mouth ---
  // M = Start Point, Q = Curve Control Point, T = End Point
  const mouthPaths = {
    smiling: "M 20 20 Q 100 80 180 20", // Deep, smooth curve
    lookLeft: "M 40 40 Q 90 60 140 40",  // Narrower, shifted
    lookRight: "M 60 40 Q 110 60 160 40", 
    curious: "M 70 50 Q 100 10 130 50 Q 100 90 70 50", // A soft circle/oval
    open: "M 50 20 Q 100 0 150 20 L 150 80 Q 100 100 50 80 Z" // Tall capsule
  };

  const eyeVariants = {
    smiling: { scaleY: 0.85, y: -5 }, // The "Squint"
    lookLeft: { x: -25, scaleY: 1, y: 0 },
    lookRight: { x: 25, scaleY: 1, y: 0 },
    curious: { scale: 1.1, y: -15 },
    open: { scale: 1.2, y: -10 }
  };

  const pupilVariants = {
    smiling: { scale: 1.1 },
    lookLeft: { x: -50 },
    lookRight: { x: 50 },
    curious: { y: -20, scale: 1.2 },
    open: { scale: 1.4 }
  };

  return (
    <div style={containerStyle}>
      <div style={faceLayout}>
        
        {/* Eyes Section */}
        <div style={eyeRow}>
          {[0, 1].map((i) => (
            <motion.div
              key={i}
              variants={eyeVariants}
              animate={expression}
              transition={springConfig}
              style={eyeSocketStyle}
            >
              <motion.div
                variants={pupilVariants}
                animate={expression}
                transition={springConfig}
                style={pupilStyle}
              />
              <motion.div
                animate={{ top: isBlinking ? "0%" : "-110%" }}
                transition={{ duration: 0.12 }}
                style={lidStyle}
              />
            </motion.div>
          ))}
        </div>

        {/* Improved SVG Mouth */}
        <div style={{ height: '120px', display: 'flex', alignItems: 'center' }}>
          <svg width="200" height="100" viewBox="0 0 200 100">
            <motion.path
              d={mouthPaths[expression]}
              fill="none"
              stroke="#00f2ff"
              strokeWidth="12"
              strokeLinecap="round"
              animate={{ d: mouthPaths[expression] }}
              transition={springConfig}
              style={{ filter: 'drop-shadow(0 0 8px #00f2ff)' }}
            />
          </svg>
        </div>
        
      </div>
    </div>
  );
};

// --- Styles & Config ---
const springConfig = { type: "spring", stiffness: 90, damping: 15 };

const containerStyle = {
  height: '100vh', backgroundColor: '#050505',
  display: 'flex', justifyContent: 'center', alignItems: 'center'
};

const faceLayout = {
  display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '60px'
};

const eyeRow = { display: 'flex', gap: '110px' };

const eyeSocketStyle = {
  width: '150px', height: '150px', backgroundColor: '#111',
  border: '4px solid #00f2ff', borderRadius: '50%',
  position: 'relative', overflow: 'hidden',
  display: 'flex', justifyContent: 'center', alignItems: 'center',
  boxShadow: '0 0 20px rgba(0, 242, 255, 0.1)'
};

const pupilStyle = {
  width: '65px', height: '65px', backgroundColor: '#00f2ff',
  borderRadius: '50%', boxShadow: '0 0 35px #00f2ff'
};

const lidStyle = {
  position: 'absolute', width: '100%', height: '100%',
  backgroundColor: '#050505', zIndex: 10
};

export default AdvancedRobotFace;
