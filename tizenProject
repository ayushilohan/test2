// app.js
function readFeatureConfig(callback) {
  tizen.filesystem.resolve(
    'wgt-private/feature-config.json',
    function(file) {
      file.readAsText(function(content) {
        try {
          const config = JSON.parse(content);
          console.log("✅ Config loaded:", config);
          callback(config);
        } catch (e) {
          console.error("❌ JSON parse error", e);
        }
      }, function(err) {
        console.error("❌ Read error", err);
      });
    },
    function(err) {
      console.error("❌ File resolve error", err);
    },
    'r'
  );
}

function startPlayer(url) {
  const video = document.getElementById("videoPlayer");
  video.src = url;
  video.load();
  video.play();
}

window.onload = function () {
  readFeatureConfig(function (config) {
    if (config.url) {
      startPlayer(config.url);
    } else {
      console.warn("⚠️ No URL found in config.");
    }
  });

  document.addEventListener("keydown", function (e) {
    if (e.keyCode === 10009) { // Return key
      tizen.application.getCurrentApplication().exit();
    }
  });
};
